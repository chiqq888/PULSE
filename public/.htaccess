RewriteEngine On

# Serve the event HTML generated by the build at the original share URL.
RewriteRule ^_seo(?:/|$) - [R=404,L,NC]
RewriteCond %{DOCUMENT_ROOT}/__PULSE_EVENT_DIRECTORY__/event-$1.html -f
RewriteRule ^user/events/([A-Za-z0-9_-]{1,200})/?$ __PULSE_EVENT_DIRECTORY__/event-$1.html [END,NC]

RewriteRule ^user/?$ explore.html [L,NC]

# Keep account and workspace URLs out of the search index.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(login|register|user|org|staff)(/|$) noindex.html [L,NC]
